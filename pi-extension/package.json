{
  "name": "@repoaudit/typescript-adapter",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "description": "Pi Extension and standalone TypeScript adapter for the existing RepoAudit Python runtime",
  "pi": {
    "extensions": [
      "./dist/src/index.js"
    ]
  },
  "files": [
    "dist/src/",
    "README.md"
  ],
  "bin": {
    "repoaudit-doctor": "./dist/src/doctor-cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test dist/tests/*.test.js",
    "lint": "tsc -p tsconfig.json --noEmit",
    "smoke": "npm run build && node dist/tests/standalone-smoke.js",
    "doctor": "npm run build && node dist/src/doctor-cli.js",
    "verify:extension-load": "npm run build && node tests/verify-extension-load.mjs",
    "verify:pack": "npm run build && node tests/verify-pack.mjs",
    "prepack": "npm run build"
  },
  "dependencies": {
    "typebox": "1.3.7"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.84.1",
    "@types/node": "24.13.3",
    "typescript": "5.9.3"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "0.84.1"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
